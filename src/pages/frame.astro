---
import FrameAxis from '../components/frame/FrameAxis.astro';
import PageMasthead from '../components/site/PageMasthead.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
    FRAME_BANDS,
    FRAME_CONTENT,
    FRAME_RENDERED_AXES,
} from '../data/frame';

const description = FRAME_CONTENT.lead;
---

<SiteLayout
    title={`${FRAME_CONTENT.title.toUpperCase()} — sstm117`}
    description={description}
>
    <PageMasthead
        caption="FRAME / CURRENT POSITIONS"
        title={FRAME_CONTENT.title}
        lead={FRAME_CONTENT.lead}
    />

    <div class="frame-page">
        <section
            class="frame-intro"
            aria-labelledby="frame-reading-contract-heading"
        >
            <p class="frame-intro__opening">
                {FRAME_CONTENT.opening}
            </p>

            <div class="frame-contract">
                <h2 id="frame-reading-contract-heading">
                    READING CONTRACT
                </h2>

                <div class="frame-contract__copy">
                    {
                        FRAME_CONTENT.readingContract.map((paragraph) => (
                            <p>{paragraph}</p>
                        ))
                    }
                </div>
            </div>
        </section>

        <aside
            class="frame-legend"
            aria-label="How to read the qualitative position lattice"
        >
            <p class="frame-legend__title">
                QUALITATIVE POSITION · NOT A SCORE
            </p>

            <div class="frame-legend__items">
                <span class="frame-legend__item">
                    <span
                        class="frame-legend__point"
                        aria-hidden="true"
                    ></span>
                    current point
                </span>

                <span class="frame-legend__item">
                    <span
                        class="frame-legend__span"
                        aria-hidden="true"
                    ></span>
                    conditional range
                </span>
            </div>
        </aside>

        <div class="frame-bands">
            {
                FRAME_BANDS.map((band) => {
                    const axes = FRAME_RENDERED_AXES.filter(
                        (axis) => axis.band === band.id,
                    );

                    const sequence = axes
                        .map(({ id }) => id)
                        .join(' · ');

                    const headingId =
                        `frame-band-${band.id.toLowerCase()}-heading`;

                    return (
                        <section
                            class="frame-band"
                            aria-labelledby={headingId}
                        >
                            <header class="frame-band__header">
                                <div class="frame-band__identity">
                                    <h2 id={headingId}>
                                        {band.id}
                                    </h2>

                                    <p class="frame-band__sequence">
                                        {sequence}
                                    </p>
                                </div>

                                <p class="frame-band__description">
                                    {band.description}
                                </p>
                            </header>

                            <div class="frame-band__axes">
                                {
                                    axes.map((axis) => (
                                        <FrameAxis axis={axis} />
                                    ))
                                }
                            </div>
                        </section>
                    );
                })
            }
        </div>
    </div>
</SiteLayout>

<style>
    .frame-page {
        padding: 0 var(--page-gutter-desktop) 72px;
    }

    .frame-intro {
        display: grid;
        grid-template-columns:
            minmax(0, 1.1fr)
            minmax(280px, 0.9fr);
        gap: clamp(36px, 7vw, 96px);
        padding: 42px 0 48px;
    }

    .frame-intro__opening {
        max-width: 58ch;
        margin: 0;
        color: var(--color-text);
        font-size: clamp(20px, 2vw, 27px);
        font-weight: 500;
        line-height: 1.35;
        letter-spacing: -0.025em;
        text-wrap: pretty;
    }

    .frame-contract {
        max-width: 66ch;
    }

    .frame-contract h2,
    .frame-band__sequence {
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: 1.3;
        letter-spacing: 0.13em;
    }

    .frame-contract h2 {
        margin: 0 0 15px;
        color: var(--color-text-dim);
        font-weight: 400;
    }

    .frame-contract__copy {
        display: grid;
        gap: 11px;
    }

    .frame-contract__copy p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 13px;
        line-height: 1.55;
    }

    .frame-legend {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin: 0;
        padding: 18px 0 18px 16px;
        border-left: 2px solid var(--color-signal);
    }

    .frame-legend__title {
        margin: 0;
        color: var(--color-text-soft);
        font-family: var(--font-mono);
        font-size: 9.5px;
        line-height: 1.4;
        letter-spacing: 0.12em;
    }

    .frame-legend__items {
        display: flex;
        align-items: center;
        gap: 24px;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 9.5px;
        line-height: 1.4;
        letter-spacing: 0.05em;
    }

    .frame-legend__item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .frame-legend__point {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--color-signal);
        box-shadow: 0 0 0 3px var(--color-bg);
    }

    .frame-legend__span {
        width: 28px;
        height: 4px;
        background: var(--color-signal);
    }

    .frame-bands {
        display: grid;
        margin-top: 38px;
    }

    .frame-band {
        padding-top: 12px;
    }

    .frame-band + .frame-band {
        margin-top: 50px;
        padding-top: 52px;
        border-top: 1px solid var(--color-line-strong);
    }

    .frame-band__header {
        display: grid;
        grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1fr);
        align-items: start;
        gap: clamp(34px, 7vw, 96px);
        padding-bottom: 22px;
    }

    .frame-band__identity {
        display: flex;
        align-items: baseline;
        gap: 18px;
        min-width: 0;
    }

    .frame-band__sequence {
        margin: 0;
        color: var(--color-text-dim);
        white-space: nowrap;
    }

    .frame-band__header h2 {
        margin: 0;
        color: var(--color-text);
        font-size: clamp(27px, 3vw, 40px);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.035em;
    }

    .frame-band__description {
        max-width: 58ch;
        margin: 2px 0 0;
        color: var(--color-text-muted);
        font-size: 14px;
        line-height: 1.55;
        text-wrap: pretty;
    }

    .frame-band__axes {
        display: grid;
    }

    @media (max-width: 859px) {
        .frame-page {
            padding:
                0
                var(--page-gutter-mobile)
                48px;
        }

        .frame-intro {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 30px 0 36px;
        }

        .frame-intro__opening {
            font-size: 19px;
            line-height: 1.4;
        }

        .frame-legend {
            display: block;
            padding: 15px 0 16px 13px;
        }

        .frame-legend__title {
            font-size: 9px;
        }

        .frame-legend__items {
            margin-top: 11px;
            gap: 18px;
            flex-wrap: wrap;
            font-size: 9px;
        }

        .frame-bands {
            margin-top: 28px;
        }

        .frame-band {
            padding-top: 8px;
        }

        .frame-band + .frame-band {
            margin-top: 34px;
            padding-top: 38px;
        }

        .frame-band__header {
            grid-template-columns: 1fr;
            gap: 12px;
            padding-bottom: 18px;
        }

        .frame-band__identity {
            gap: 14px;
        }

        .frame-band__header h2 {
            font-size: 28px;
        }

        .frame-band__description {
            margin-top: 0;
        }
    }
</style>

---
import PageMasthead from '../components/site/PageMasthead.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
    ABOUT_CONTENT,
    PRACTICE_APPLICATIONS,
} from '../data/about-content';
import {
    GITHUB_PROFILE_LOCATOR,
    GITHUB_PROFILE_URL,
    SITE_REPOSITORY_LOCATOR,
    SITE_REPOSITORY_URL,
} from '../lib/public-links';

const { masthead, sections, practice, direction, exit } = ABOUT_CONTENT;
---

<SiteLayout title="ABOUT — sstm117" description={masthead.lead}>
    <div class="about-surface">
        <PageMasthead
            caption={masthead.caption}
            title={masthead.title}
            lead={masthead.lead}
        />

        {
            sections.map((section) => (
                <section
                    class="about-section"
                    aria-labelledby={section.id}
                >
                    <h2 id={section.id} class="about-section__heading">
                        {section.heading}
                    </h2>

                    <div class="about-section__body">
                        {section.paragraphs.map((paragraph) => (
                            <p>{paragraph}</p>
                        ))}
                    </div>
                </section>
            ))
        }

        <section class="about-section" aria-labelledby={practice.id}>
            <h2 id={practice.id} class="about-section__heading">
                {practice.heading}
            </h2>

            <div class="about-section__body">
                <p class="about-practice__note">{practice.note}</p>

                <dl class="about-practice">
                    {
                        PRACTICE_APPLICATIONS.map(
                            ({ invariant, application }) => (
                                <div>
                                    <dt>{invariant}</dt>
                                    <dd>{application}</dd>
                                </div>
                            ),
                        )
                    }
                </dl>

                <section
                    class="about-frame-bridge"
                    aria-labelledby="about-frame-bridge-heading"
                >
                    <p class="about-frame-bridge__eyebrow">
                        FRAME
                    </p>

                    <div class="about-frame-bridge__body">
                        <h3 id="about-frame-bridge-heading">
                            CURRENT POSITIONS
                        </h3>

                        <p>
                            How these principles behave when legitimate
                            engineering pressures conflict.
                        </p>

                        <a
                            class="about-frame-bridge__link"
                            href="/frame"
                        >
                            EXPLORE FRAME <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </section>
            </div>
        </section>

        <section class="about-section" aria-labelledby={direction.id}>
            <h2 id={direction.id} class="about-section__heading">
                {direction.heading}
            </h2>

            <div class="about-section__body">
                {direction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
        </section>

        <section class="about-section" aria-labelledby={exit.id}>
            <h2 id={exit.id} class="about-section__heading">
                {exit.heading}
            </h2>

            <div class="about-section__body">
                {exit.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

                <ul class="about-links" role="list">
                    <li>
                        <a class="about-links__link" href={GITHUB_PROFILE_URL}>
                            {GITHUB_PROFILE_LOCATOR}
                        </a>
                        <span class="about-links__gloss">
                            public presence
                        </span>
                    </li>

                    <li>
                        <a class="about-links__link" href={SITE_REPOSITORY_URL}>
                            {SITE_REPOSITORY_LOCATOR}
                        </a>
                        <span class="about-links__gloss">
                            the source of this site
                        </span>
                    </li>
                </ul>
            </div>
        </section>
    </div>
</SiteLayout>

<style>
    .about-surface {
        width: 100%;
    }

    .about-section {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        gap: 30px;
        align-items: start;
        padding: 26px var(--page-gutter-desktop) 28px;
        border-bottom: 1px solid var(--color-line);
    }

    .about-section:last-of-type {
        border-bottom: 0;
    }

    .about-section__heading {
        margin: 0;
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 9.5px;
        font-weight: 400;
        line-height: 1.7;
        letter-spacing: 0.14em;
    }

    .about-section__body {
        max-width: 72ch;
    }

    .about-section__body p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
        line-height: 1.68;
        text-wrap: pretty;
    }

    .about-section__body p + p {
        margin-top: 16px;
    }

    .about-practice__note {
        color: var(--color-text-soft) !important;
    }

    .about-practice {
        display: grid;
        margin: 22px 0 0;
        border-top: 1px solid var(--color-line);
    }

    .about-practice > div {
        display: grid;
        grid-template-columns: 236px minmax(0, 1fr);
        gap: 24px;
        align-items: baseline;
        padding: 14px 0 15px;
        border-bottom: 1px solid oklch(0.21 0.008 200);
    }

    .about-practice dt {
        color: var(--color-text-soft);
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: 1.5;
        letter-spacing: 0.1em;
    }

    .about-practice dd {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 14px;
        line-height: 1.62;
        text-wrap: pretty;
    }

    .about-frame-bridge {
        display: grid;
        grid-template-columns: 126px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
        margin-top: 28px;
        padding: 18px 0 20px 16px;
        border-left: 2px solid var(--color-signal);
    }

    .about-frame-bridge__eyebrow {
        margin: 3px 0 0 !important;
        color: var(--color-text-dim) !important;
        font-family: var(--font-mono);
        font-size: 9.5px !important;
        line-height: 1.4 !important;
        letter-spacing: 0.14em;
    }

    .about-frame-bridge__body h3 {
        margin: 0 0 8px;
        color: var(--color-text);
        font-size: 20px;
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .about-frame-bridge__body p {
        max-width: 52ch;
        font-size: 13.5px;
        line-height: 1.55;
    }

    .about-frame-bridge__link {
        display: inline-block;
        margin-top: 14px;
        color: var(--color-text-soft);
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: 0.1em;
        text-decoration: underline;
        text-decoration-color: var(--color-signal);
        text-underline-offset: 4px;
    }

    .about-frame-bridge__link:hover,
    .about-frame-bridge__link:focus-visible {
        color: var(--color-signal-hover);
    }

    .about-links {
        display: grid;
        gap: 0;
        margin: 22px 0 0;
        padding: 0;
        border-top: 1px solid var(--color-line);
        list-style: none;
    }

    .about-links li {
        display: flex;
        align-items: baseline;
        gap: 16px;
        padding: 12px 0 13px;
        border-bottom: 1px solid oklch(0.21 0.008 200);
        flex-wrap: wrap;
    }

    .about-links__link {
        color: var(--color-text);
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.4;
        letter-spacing: 0.04em;
        text-decoration: underline;
        text-decoration-color: var(--color-signal);
        text-underline-offset: 4px;
    }

    .about-links__link:hover,
    .about-links__link:focus-visible {
        color: var(--color-signal-hover);
    }

    .about-links__gloss {
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 9.5px;
        letter-spacing: 0.1em;
    }

    @media (max-width: 859px) {
        .about-section {
            display: block;
            padding: 20px var(--page-gutter-mobile) 22px;
        }

        .about-section__heading {
            margin-bottom: 12px;
            font-size: 9px;
            line-height: 1;
        }

        .about-section__body {
            max-width: none;
        }

        .about-section__body p {
            font-size: 14.5px;
            line-height: 1.62;
        }

        .about-practice > div {
            display: block;
            padding: 13px 0 14px;
        }

        .about-practice dd {
            margin-top: 8px;
            font-size: 14px;
        }

        .about-frame-bridge {
            display: block;
            margin-top: 24px;
            padding: 16px 0 18px 14px;
        }

        .about-frame-bridge__eyebrow {
            margin-bottom: 9px !important;
            font-size: 9px !important;
        }

        .about-frame-bridge__body h3 {
            font-size: 19px;
        }

        .about-frame-bridge__body p {
            font-size: 13.5px;
            line-height: 1.55;
        }

        .about-frame-bridge__link {
            margin-top: 12px;
            padding: 6px 0;
        }

        .about-links li {
            padding: 14px 0;
            gap: 4px 14px;
        }
    }
</style>

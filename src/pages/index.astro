---
import FieldFigure from '../components/field/FieldFigure.astro';
import PlottedSystemsRoster from '../components/field/PlottedSystemsRoster.astro';
import RelationIndex from '../components/field/RelationIndex.astro';
import SystemReadout from '../components/field/SystemReadout.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { INDEX_CONTENT } from '../data/index-content';
import { READOUT_SUBJECT } from '../data/field-selection';
import { fieldEmphasisCss } from '../lib/field-emphasis';
import { GITHUB_PROFILE_URL } from '../lib/public-links';

const relationEmphasisCss = fieldEmphasisCss();

const middleDot = String.fromCodePoint(0x00b7);
const emDash = String.fromCodePoint(0x2014);

const identityNameLines = INDEX_CONTENT.identity.name.split(/ (?=[^ ]+$)/);

if (identityNameLines.length !== 2) {
    throw new Error('INDEX identity name must resolve to exactly two presentation lines.');
}

const identityTailParts = INDEX_CONTENT.identity.tail.split(` ${emDash} `);

if (identityTailParts.length !== 3) {
    throw new Error('INDEX identity tail must resolve to exactly three presentation segments.');
}

---

<SiteLayout
    description={INDEX_CONTENT.identity.lead}
>
    <div class="index-surface">
        <section
            class="index-field-stage"
            aria-labelledby="index-identity"
        >
            <div class="index-identity">
                <div class="index-identity__caption">
                    PRACTICE {middleDot} {INDEX_CONTENT.closing.mark}
                </div>

                <h1
                    id="index-identity"
                    class="index-identity__name"
                >
                    {identityNameLines[0]}<br />{identityNameLines[1]}
                </h1>

                <p class="index-identity__lead">
                    {INDEX_CONTENT.identity.lead}
                </p>

                <p class="index-identity__tail">
                    {identityTailParts[0]}{' '}{emDash}{' '}
                    <span>{identityTailParts[1]}</span>
                    {' '}{emDash}{' '}{identityTailParts[2]}
                </p>
            </div>

            <FieldFigure />

            <div class="index-field-caption">
                <h2 class="index-field-caption__heading">
                    THE FIELD
                </h2>

            </div>
            <PlottedSystemsRoster />
            <SystemReadout subject={READOUT_SUBJECT} />
        </section>

        <section class="index-relation-row">
            <RelationIndex />

        </section>

        <section
            class="index-invariants"
            aria-labelledby="index-invariants-heading"
        >
            <h2
                id="index-invariants-heading"
                class="index-invariants__heading"
            >
                PRACTICE<br /> INVARIANTS
            </h2>

            <div class="index-invariants__items">
                {
                    INDEX_CONTENT.invariants.map((invariant) => (
                        <span data-practice-invariant>
                            {invariant}
                        </span>
                    ))
                }
            </div>
        </section>

        <div class="index-closing-row">
            <span class="index-closing-row__prompt" aria-hidden="true">
                &gt;_
            </span>

            <a
                class="index-closing-row__locator"
                href={GITHUB_PROFILE_URL}
            >
                {INDEX_CONTENT.closing.locator}
            </a>

            <span class="index-closing-row__mark">
                {INDEX_CONTENT.closing.mark}
            </span>
        </div>

        <style is:inline set:html={relationEmphasisCss}></style>
    </div>
</SiteLayout>

<style>
    .index-surface {
        width: 100%;
    }

    .index-field-stage {
        position: relative;
        width: 100%;
        max-width: 1480px;
        margin-inline: auto;
    }

    .index-identity {
        position: absolute;
        top: 46px;
        left: 34px;
        z-index: 4;
        width: 40%;
        max-width: 470px;
        pointer-events: none;
    }

    .index-identity__caption {
        margin-bottom: 22px;
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1;
        letter-spacing: 0.16em;
    }

    .index-identity__name {
        margin: 0 0 20px;
        color: var(--color-text);
        font-size: clamp(38px, 4.2vw, 64px);
        font-weight: 600;
        line-height: 0.94;
        letter-spacing: -0.04em;
    }

    .index-identity__lead {
        max-width: 24ch;
        margin: 0 0 18px;
        color: var(--color-text);
        font-size: 20px;
        line-height: 1.35;
        letter-spacing: -0.012em;
    }

    .index-identity__tail {
        max-width: 46ch;
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
        line-height: 1.6;
        text-wrap: pretty;
    }

    .index-identity__tail span {
        color: oklch(0.88 0.006 200);
    }

    .index-field-caption {
        display: flex;
        align-items: baseline;
        gap: 18px;
        padding: 0 32px 20px;
        flex-wrap: wrap;
    }

    .index-field-caption__heading {
        margin: 0;
        color: var(--color-text);
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0.16em;
    }


    .index-relation-row {
        padding: 30px 32px 34px;
        border-top: 1px solid var(--color-line);
    }

    .index-invariants {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 26px;
        align-items: start;
        padding: 20px 32px 22px;
        border-top: 1px solid var(--color-line);
    }

    .index-invariants__heading {
        margin: 0;
        color: oklch(0.60 0.008 200);
        font-family: var(--font-mono);
        font-size: 9.5px;
        font-weight: 400;
        line-height: 1.7;
        letter-spacing: 0.14em;
    }

    .index-invariants__items {
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(215px, 1fr));
        gap: 9px 26px;
        color: oklch(0.78 0.006 200);
        font-family: var(--font-mono);
        font-size: 10px;
        line-height: 1.5;
        letter-spacing: 0.1em;
    }

    .index-closing-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 22px 32px;
        border-top: 1px solid var(--color-line);
        color: oklch(0.60 0.008 200);
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1;
        flex-wrap: wrap;
    }

    .index-closing-row__prompt {
        color: var(--color-signal);
    }

    .index-closing-row__locator {
        color: var(--color-text-soft);
        text-decoration: underline;
        text-decoration-color: var(--color-signal);
        text-underline-offset: 4px;
    }

    .index-closing-row__locator:hover,
    .index-closing-row__locator:focus-visible {
        color: var(--color-signal-hover);
    }

    .index-closing-row__mark {
        margin-left: auto;
    }

    @media (max-width: 1319px) {
        .index-identity {
            position: static;
            width: auto;
            max-width: 660px;
            padding: 44px 34px 10px;
            pointer-events: auto;
        }
    }

    @media (max-width: 859px) {
        .index-field-stage {
            max-width: none;
        }

        .index-relation-row {
            display: block;
            padding: 16px var(--page-gutter-mobile) 10px;
        }

        .index-closing-row {
            gap: 12px;
            padding: 14px var(--page-gutter-mobile) 20px;
            font-size: 10px;
        }

        .index-closing-row__locator {
            /* Padding lifts the tap target without moving the underline. */
            margin: -11px 0;
            padding: 11px 0;
        }

        .index-invariants {
            display: block;
            padding: 14px var(--page-gutter-mobile) 16px;
        }

        .index-invariants__heading {
            margin-bottom: 9px;
            font-size: 9px;
            line-height: 1;
        }

        .index-invariants__heading br {
            display: none;
        }

        .index-invariants__items {
            grid-template-columns: 1fr;
            gap: 5px;
            color: oklch(0.76 0.008 200);
            font-size: 9.5px;
            line-height: 1.4;
            letter-spacing: 0.08em;
        }

        .index-identity {
            max-width: none;
            padding: 28px var(--page-gutter-mobile) 22px;
        }

        .index-identity__caption {
            margin-bottom: 16px;
            font-size: 9.5px;
        }

        .index-identity__name {
            margin-bottom: 16px;
            font-size: 36px;
            line-height: 0.96;
            letter-spacing: -0.035em;
        }

        .index-identity__lead {
            max-width: none;
            margin: 0;
            font-size: 17px;
            line-height: 1.35;
            letter-spacing: -0.01em;
        }

        /*
         * The operations -> software/AI continuity is meaning, not decoration.
         * It stays on mobile even though the diagram does not.
         */
        .index-identity__tail {
            max-width: none;
            margin-top: 16px;
            font-size: 14px;
            line-height: 1.55;
        }

        .index-field-caption {
            display: none;
        }
    }
</style>

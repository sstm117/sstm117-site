---
import PageMasthead from '../components/site/PageMasthead.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { INDEX_CONTENT } from '../data/index-content';
import { notes } from '../data/notes';

const lead =
    'Occasional writing about how systems behave, and about what it takes to say so honestly.';
---

<SiteLayout title="NOTES — sstm117" description={lead}>
    <div class="notes-surface">
        <PageMasthead
            caption={`WRITING · ${INDEX_CONTENT.closing.mark}`}
            title="Notes"
            lead={lead}
        />

        {
            notes.map((note) => (
                <article
                    class="note"
                    id={note.slug}
                    aria-labelledby={`${note.slug}-heading`}
                    data-note
                >
                    <header class="note__header">
                        <time class="note__date" datetime={note.date}>
                            {note.date}
                        </time>

                        <h2 id={`${note.slug}-heading`} class="note__title">
                            {note.title}
                        </h2>

                        <p class="note__standfirst">{note.standfirst}</p>
                    </header>

                    <div class="note__body">
                        {note.body.map((paragraph) => (
                            <p>{paragraph}</p>
                        ))}
                    </div>
                </article>
            ))
        }
    </div>
</SiteLayout>

<style>
    .notes-surface {
        width: 100%;
    }

    .note {
        padding: 34px var(--page-gutter-desktop) 40px;
        scroll-margin-block-start: 18px;
    }

    .note + .note {
        border-top: 1px solid var(--color-line);
    }

    .note__header {
        max-width: 68ch;
    }

    .note__date {
        display: block;
        margin-bottom: 16px;
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 9.5px;
        line-height: 1;
        letter-spacing: 0.14em;
    }

    .note__title {
        max-width: 22ch;
        margin: 0 0 14px;
        color: var(--color-text);
        font-size: 30px;
        font-weight: 500;
        line-height: 1.12;
        letter-spacing: -0.028em;
    }

    .note__standfirst {
        margin: 0;
        color: var(--color-text-soft);
        font-size: 16px;
        line-height: 1.5;
        letter-spacing: -0.008em;
        text-wrap: pretty;
    }

    .note__body {
        max-width: 68ch;
        margin-top: 26px;
        padding-top: 22px;
        border-top: 1px solid var(--color-line);
    }

    .note__body p {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15.5px;
        line-height: 1.72;
        text-wrap: pretty;
    }

    .note__body p + p {
        margin-top: 18px;
    }

    @media (max-width: 859px) {
        .note {
            padding: 24px var(--page-gutter-mobile) 30px;
        }

        .note__title {
            max-width: none;
            font-size: 25px;
            letter-spacing: -0.022em;
        }

        .note__standfirst {
            font-size: 15px;
        }

        .note__body {
            max-width: none;
            margin-top: 22px;
            padding-top: 18px;
        }

        .note__body p {
            font-size: 15px;
            line-height: 1.68;
        }
    }
</style>

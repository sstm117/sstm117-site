---
import type { WorkEntryView } from '../../lib/work-view';

interface Props {
    entry: WorkEntryView;
}

const { entry } = Astro.props;
const headingId = `work-${entry.anchor}-heading`;
---

<article
    class="work-entry"
    id={entry.anchor}
    aria-labelledby={headingId}
    data-work-entry
>
    <p class="work-entry__meta">
        {
            entry.meta.map((item, index) => (
                <>
                    {index > 0 && (
                        <span
                            class="work-entry__meta-separator"
                            aria-hidden="true"
                        >
                            {' · '}
                        </span>
                    )}
                    <span>{item}</span>
                </>
            ))
        }
    </p>

    <h2 id={headingId} class="work-entry__name">
        {entry.name}
    </h2>

    <p class="work-entry__lede">
        {entry.lede}
    </p>

    <dl class="work-entry__facts">
        <div>
            <dt>QUESTION</dt>
            <dd>{entry.question}</dd>
        </div>

        <div>
            <dt>CONTRIBUTION</dt>
            <dd>{entry.contribution}</dd>
        </div>

        <div>
            <dt>TODAY</dt>
            <dd>
                <ul class="work-entry__list" role="list">
                    {entry.today.map((item) => <li>{item}</li>)}
                </ul>
            </dd>
        </div>

        <div>
            <dt>NOT YET</dt>
            <dd>
                <ul class="work-entry__list" role="list">
                    {entry.notYet.map((item) => <li>{item}</li>)}
                </ul>
            </dd>
        </div>

        <div>
            <dt>CONSTRAINT</dt>
            <dd>{entry.constraint}</dd>
        </div>

        {
            entry.unknowns.length > 0 && (
                <div>
                    <dt>STILL OPEN</dt>
                    <dd>
                        <ul class="work-entry__list" role="list">
                            {entry.unknowns.map((item) => <li>{item}</li>)}
                        </ul>
                    </dd>
                </div>
            )
        }

        {
            entry.tech && (
                <div>
                    <dt>{entry.tech.label}</dt>
                    <dd class="work-entry__mono">
                        {entry.tech.items.join(' · ')}
                    </dd>
                </div>
            )
        }

        <div>
            <dt>SOURCE</dt>
            <dd class="work-entry__mono">
                {
                    entry.source.public ? (
                        <a
                            class="work-entry__source-link"
                            href={entry.source.href}
                            rel="noopener"
                        >
                            {entry.source.label}
                        </a>
                    ) : (
                        entry.source.note
                    )
                }
            </dd>
        </div>
    </dl>
</article>

<style>
    .work-entry {
        padding: 30px var(--page-gutter-desktop) 34px;
        border-top: 1px solid var(--color-line);
        scroll-margin-block-start: 18px;
    }

    .work-entry:first-of-type {
        border-top: 0;
    }

    .work-entry__meta {
        margin: 0 0 14px;
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 9.5px;
        line-height: 1.5;
        letter-spacing: 0.13em;
    }

    .work-entry__name {
        max-width: 26ch;
        margin: 0 0 12px;
        color: var(--color-text);
        font-size: 27px;
        font-weight: 500;
        line-height: 1.1;
        letter-spacing: -0.025em;
    }

    .work-entry__lede {
        max-width: 74ch;
        margin: 0;
        color: var(--color-text-muted);
        font-size: 15px;
        line-height: 1.6;
        text-wrap: pretty;
    }

    .work-entry__facts {
        display: grid;
        margin: 24px 0 0;
        border-top: 1px solid var(--color-line);
    }

    .work-entry__facts > div {
        display: grid;
        grid-template-columns: 132px minmax(0, 1fr);
        gap: 20px;
        align-items: baseline;
        padding: 13px 0 14px;
        border-bottom: 1px solid oklch(0.21 0.008 200);
    }

    .work-entry__facts dt {
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 9px;
        line-height: 1.5;
        letter-spacing: 0.12em;
    }

    .work-entry__facts dd {
        max-width: 78ch;
        margin: 0;
        color: var(--color-text-muted);
        font-size: 13.5px;
        line-height: 1.6;
        text-wrap: pretty;
    }

    .work-entry__list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .work-entry__list li {
        position: relative;
        padding-left: 16px;
    }

    .work-entry__list li + li {
        margin-top: 6px;
    }

    .work-entry__list li::before {
        content: '';
        position: absolute;
        top: 0.62em;
        left: 0;
        width: 6px;
        height: 1px;
        background: var(--color-line-strong);
    }

    .work-entry__mono {
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1.7;
        letter-spacing: 0.06em;
    }

    .work-entry__source-link {
        color: var(--color-text-soft);
        text-decoration: underline;
        text-decoration-color: var(--color-signal);
        text-underline-offset: 4px;
    }

    .work-entry__source-link:hover,
    .work-entry__source-link:focus-visible {
        color: var(--color-signal-hover);
    }

    @media (max-width: 859px) {
        .work-entry {
            padding: 22px var(--page-gutter-mobile) 24px;
        }

        .work-entry__name {
            max-width: none;
            font-size: 23px;
            letter-spacing: -0.02em;
        }

        .work-entry__lede {
            max-width: none;
            font-size: 14px;
            line-height: 1.55;
        }

        .work-entry__facts {
            margin-top: 20px;
        }

        .work-entry__facts > div {
            display: block;
            padding: 12px 0 13px;
        }

        .work-entry__facts dd {
            max-width: none;
            margin-top: 7px;
            font-size: 13.5px;
        }
    }
</style>

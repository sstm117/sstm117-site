---
interface Props {
    caption: string;
    title: string;
    lead: string;
}

const { caption, title, lead } = Astro.props;
---

<header class="page-masthead">
    <p class="page-masthead__caption">
        {caption}
    </p>

    <h1 class="page-masthead__title">
        {title}
    </h1>

    <p class="page-masthead__lead">
        {lead}
    </p>

    <slot />
</header>

<style>
    .page-masthead {
        padding: 46px var(--page-gutter-desktop) 30px;
        border-bottom: 1px solid var(--color-line);
    }

    .page-masthead__caption {
        margin: 0 0 22px;
        color: var(--color-text-dim);
        font-family: var(--font-mono);
        font-size: 10.5px;
        line-height: 1;
        letter-spacing: 0.16em;
    }

    .page-masthead__title {
        margin: 0 0 18px;
        color: var(--color-text);
        font-size: clamp(34px, 3.4vw, 52px);
        font-weight: 600;
        line-height: 0.96;
        letter-spacing: -0.04em;
    }

    .page-masthead__lead {
        max-width: 58ch;
        margin: 0;
        color: var(--color-text-soft);
        font-size: 18px;
        line-height: 1.45;
        letter-spacing: -0.01em;
        text-wrap: pretty;
    }

    @media (max-width: 859px) {
        .page-masthead {
            padding: 28px var(--page-gutter-mobile) 22px;
        }

        .page-masthead__caption {
            margin-bottom: 16px;
            font-size: 9.5px;
        }

        .page-masthead__title {
            margin-bottom: 14px;
            font-size: 32px;
            letter-spacing: -0.035em;
        }

        .page-masthead__lead {
            max-width: none;
            font-size: 16px;
            line-height: 1.4;
        }
    }
</style>
